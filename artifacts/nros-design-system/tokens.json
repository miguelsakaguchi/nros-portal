{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f4faf9" },
      "foreground": { "$value": "#15343b" },
      "border": { "$value": "#d7e8e5" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#15343b" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#15343b" },
      "primary": {
        "$value": "#0f766e",
        "$description": "Teal de identidade para navegação, ações principais e foco."
      },
      "primaryForeground": { "$value": "#f4fffd" },
      "secondary": { "$value": "#dff4f0" },
      "secondaryForeground": { "$value": "#124e55" },
      "muted": { "$value": "#e8f1f0" },
      "mutedForeground": { "$value": "#5b7378" },
      "accent": { "$value": "#f4c95d" },
      "accentForeground": { "$value": "#5b3a00" },
      "destructive": { "$value": "#c2413b" },
      "destructiveForeground": { "$value": "#fff8f7" },
      "input": { "$value": "#c5dcd9" },
      "ring": { "$value": "#28a99e" },
      "chart1": { "$value": "#168b81" },
      "chart2": { "$value": "#45b7a9" },
      "chart3": { "$value": "#f4c95d" },
      "chart4": { "$value": "#d67568" },
      "chart5": { "$value": "#5576a8" },
      "sidebar": { "$value": "#e9f6f3" },
      "sidebarForeground": { "$value": "#24525a" },
      "sidebarBorder": { "$value": "#cfe5e1" },
      "sidebarPrimary": { "$value": "#0f766e" },
      "sidebarPrimaryForeground": { "$value": "#f4fffd" },
      "sidebarAccent": { "$value": "#cfece7" },
      "sidebarAccentForeground": { "$value": "#124e55" },
      "sidebarRing": { "$value": "#28a99e" }
    },
    "dark": {
      "background": { "$value": "#0c2226" },
      "foreground": { "$value": "#edf8f6" },
      "border": { "$value": "#23484d" },
      "card": { "$value": "#123237" },
      "cardForeground": { "$value": "#edf8f6" },
      "popover": { "$value": "#123237" },
      "popoverForeground": { "$value": "#edf8f6" },
      "primary": { "$value": "#45c7ba" },
      "primaryForeground": { "$value": "#063b37" },
      "secondary": { "$value": "#19464b" },
      "secondaryForeground": { "$value": "#d9f4ef" },
      "muted": { "$value": "#173b40" },
      "mutedForeground": { "$value": "#9ac1be" },
      "accent": { "$value": "#e9b949" },
      "accentForeground": { "$value": "#3b2700" },
      "destructive": { "$value": "#f06a61" },
      "destructiveForeground": { "$value": "#3d100d" },
      "input": { "$value": "#285158" },
      "ring": { "$value": "#72ddd1" },
      "chart1": { "$value": "#45c7ba" },
      "chart2": { "$value": "#77d8c7" },
      "chart3": { "$value": "#e9b949" },
      "chart4": { "$value": "#f08b7e" },
      "chart5": { "$value": "#8eaee0" },
      "sidebar": { "$value": "#102d32" },
      "sidebarForeground": { "$value": "#d9f4ef" },
      "sidebarBorder": { "$value": "#23484d" },
      "sidebarPrimary": { "$value": "#45c7ba" },
      "sidebarPrimaryForeground": { "$value": "#063b37" },
      "sidebarAccent": { "$value": "#19464b" },
      "sidebarAccentForeground": { "$value": "#d9f4ef" },
      "sidebarRing": { "$value": "#72ddd1" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Plus Jakarta Sans", "Inter", "sans-serif"],
        "$description": "Tipografia de interface, escolhida para leitura executiva e acessibilidade."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.625rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
